# Canonical dashboard origin. Do not add a trailing slash.
DASHBOARD_URL=http://localhost:3000

# Auth.js and Discord OAuth. Generate NEXTAUTH_SECRET with: openssl rand -base64 32
NEXTAUTH_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Comma-separated Discord IDs allowed to access Premium & Billing.
# Use the same value configured on Railway for the bot.
BOT_OWNER_IDS=

# Railway bot API origin and the shared server-to-server secret.
BOT_API_URL=https://your-bot.up.railway.app
DASHBOARD_API_SECRET=

# AUTH_URL and NEXTAUTH_URL are intentionally unset. Auth.js v5 uses the
# incoming request host, and the app does not configure redirectProxyUrl.
