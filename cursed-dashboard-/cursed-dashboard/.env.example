# --- MongoDB (shared with the bot — dashboard writes config, bot reads it) ---
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net
MONGODB_DB_NAME=cursed

# --- Discord OAuth2 ---
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# --- Bot metadata (used by the invite button / landing stats) ---
NEXT_PUBLIC_DISCORD_APP_ID=
NEXT_PUBLIC_SUPPORT_SERVER_URL=https://discord.gg/your-invite

# --- Internal API auth between dashboard and the bot's health server (Railway) ---
# The bot exposes a small read-only status endpoint; this key authenticates the dashboard to it.
BOT_STATUS_API_URL=https://your-bot.up.railway.app
BOT_STATUS_API_KEY=
